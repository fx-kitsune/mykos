#!/bin/sh
# Debian live-build binary hook: own BIOS menu, shared with UEFI.
cd ..
. config/binary
set -e
# Biến ghi đè chỉ dùng cho kiểm thử; bản dựng dùng gói chính thức trên máy tạo ảnh.
module_root=${MYKOS_SYSLINUX_ROOT:-/usr/lib}
target=binary/isolinux
mkdir -p "$target"
cp "$module_root/ISOLINUX/isolinux.bin" "$target/isolinux.bin"
for module in menu.c32 ldlinux.c32 libcom32.c32 libutil.c32; do
    cp "$module_root/syslinux/modules/bios/$module" "$target/$module"
done

kernel=$(find binary/live -maxdepth 1 -type f -name 'vmlinuz-*' -printf '%f\n' | sort -V | tail -n 1)
[ -n "$kernel" ] || { echo 'Không tìm thấy nhân trong binary/live.' >&2; exit 1; }
initrd="initrd.img-${kernel#vmlinuz-}"
[ -f "binary/live/$initrd" ] || { echo 'Thiếu initrd tương ứng với nhân đã chọn.' >&2; exit 1; }
# Menu BIOS dùng ký tự ASCII để không phụ thuộc phông Unicode của firmware.
{
    printf 'ui menu.c32\ndefault mykos\nprompt 0\ntimeout 50\nmenu title MyKOS\n'
    printf 'label mykos\n  menu label Khoi dong MyKOS (phien truc tiep)\n'
    printf '  kernel /live/%s\n  append initrd=/live/%s %s\n' "$kernel" "$initrd" "$LB_BOOTAPPEND_LIVE"
    printf 'label mykos-safe\n  menu label MyKOS (do hoa an toan)\n'
    printf '  kernel /live/%s\n  append initrd=/live/%s %s nomodeset\n' "$kernel" "$initrd" "$LB_BOOTAPPEND_LIVE"
    printf 'label mykos-software\n  menu label MyKOS (do hoa phan mem cho may ao)\n'
    printf '  kernel /live/%s\n  append initrd=/live/%s %s systemd.setenv=QT_QUICK_BACKEND=software\n' "$kernel" "$initrd" "$LB_BOOTAPPEND_LIVE"
} > "$target/isolinux.cfg"
