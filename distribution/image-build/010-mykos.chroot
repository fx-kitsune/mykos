#!/bin/sh
set -eu
# Own identity; Debian is a temporary package provider.
rm -f /etc/os-release
cat > /usr/lib/os-release <<'RELEASE'
NAME="MyKOS"
ID=mykos
ID_LIKE=debian
PRETTY_NAME="MyKOS 0.1 development"
VERSION_ID="0.1"
VARIANT="MyKOS Desktop"
VARIANT_ID=mykos
RELEASE
ln -s ../usr/lib/os-release /etc/os-release
printf 'MyKOS development live image — not a validated release\n' > /etc/issue
printf '/usr/bin/sddm\n' > /etc/X11/default-display-manager
systemctl enable sddm.service
systemctl set-default graphical.target
# Keep machine identity unique per installation/live session.
: > /etc/machine-id
rm -f /var/lib/dbus/machine-id
ln -s /etc/machine-id /var/lib/dbus/machine-id
